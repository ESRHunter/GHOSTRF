<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.RFHubStudio" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/white</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="materialButtonStyle">@style/Widget.RFHub.Button</item>
    </style>

    <style name="Theme.RFHubStudio.Splash" parent="Theme.RFHubStudio">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <style name="Widget.RFHub.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@null</item>
        <item name="cornerRadius">0dp</item>
        <item name="elevation">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:fontFamily">monospace</item>
    </style>
</resources>
