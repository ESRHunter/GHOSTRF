<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/square_btn_bg"
    android:padding="6dp"
    android:layout_marginBottom="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPacketTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14:20:15"
            android:textColor="@color/text_secondary"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tvPacketProto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="EV1527"
            android:textColor="@color/accent_green"
            android:textSize="10sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvPacketRssi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-68 dBm"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/tvPacketCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0x547A11 (24 bit, TE=320µs)"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvPacketFreq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="433.92 МГц"
            android:textColor="@color/text_secondary"
            android:textSize="9sp"
            android:fontFamily="monospace" />
    </LinearLayout>
</LinearLayout>
